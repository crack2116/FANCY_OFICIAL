# FANCYPERU - Dokploy deployment environment contract
# Paste these values into the Dokploy Compose service environment.
# NEVER commit real values. Generate secrets with: openssl rand -hex 32
# Hex avoids URL-encoding and .env quoting problems in DATABASE_URL/REDIS_URL.
# NEXT_PUBLIC_* values are inlined into the storefront bundle at BUILD time:
# changing them requires rebuilding the storefront image, not only a restart.
# The backend refuses to boot in production without S3 configuration.

# --- Core ---
MEDUSA_WORKER_MODE=shared
MEDUSA_FF_RBAC=true
COOKIE_SECURE=true

# --- PostgreSQL (dedicated, not Dokploy's internal DB) ---
POSTGRES_DB=fancyperu_production
POSTGRES_USER=fancyperu_prod_admin
POSTGRES_PASSWORD=

# --- Redis (dedicated) ---
REDIS_PASSWORD=

# --- Medusa core secrets ---
JWT_SECRET=
COOKIE_SECRET=
# Required in production: the backend and storefront use it to sign/verify
# order-possession tokens.
ORDER_TOKEN_SECRET=

# --- Public hosts and CORS ---
# Hosts only (no scheme). In production Traefik issues HTTPS certificates.
# For the PRIVATE LAN TEST use nip.io wildcard domains that resolve to the
# host (no DNS change needed), with plain HTTP through Traefik's web
# entrypoint, for example:
#   api.192.168.1.38.nip.io / shop.192.168.1.38.nip.io / s3.192.168.1.38.nip.io
#   + PUBLIC_SCHEME=http TRAEFIK_ENTRYPOINT=web TRAEFIK_TLS=false
API_DOMAIN=
STOREFRONT_DOMAIN=
S3_DOMAIN=
# Full origins, for example https://shop.example.com
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=

# --- Object storage (MinIO, internal endpoint) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=fancyperu-media
S3_PRIVATE_BUCKET=fancyperu-private
S3_REGION=us-east-1

# --- Payments (Culqi). Leave disabled until verified. ---
CULQI_ENABLED=false
CULQI_API_URL=https://api.culqi.com/v2
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
CULQI_AUTO_CAPTURE=true

# --- Google auth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Authorization allowlists ---
FINANCIAL_AUTHORIZED_ADMIN_EMAILS=

# --- Shipping matrix (JSON, optional) ---
SHIPPING_MATRIX_JSON=

# --- Storefront (NEXT_PUBLIC_* values are baked at build time) ---
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=pe
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
NEXT_PUBLIC_YAPE_PHONE=
NEXT_PUBLIC_PLIN_PHONE=
NEXT_PUBLIC_BANK_ACCOUNTS=
# NEXT_PUBLIC_MEDUSA_BACKEND_URL and NEXT_PUBLIC_BASE_URL are derived from
# API_DOMAIN/STOREFRONT_DOMAIN by docker-compose.dokploy.yml. Do not set them.

# --- Private test switch ---
# TRAEFIK_ENABLE=false = no Traefik router at all.
# In production: PUBLIC_SCHEME https, TRAEFIK_ENTRYPOINT websecure,
# TRAEFIK_TLS true (defaults below). For the private LAN test override all
# three to run plain HTTP through the web entrypoint (port 80).
TRAEFIK_ENABLE=true
PUBLIC_SCHEME=https
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Staging seed (manual docker exec only; not read by Compose) ---
# STAGING_ADMIN_EMAIL=staging-admin@fancyperu.com
# STAGING_ADMIN_PASSWORD=
